{
  "openapi": "3.1.0",
  "info": {
    "title": "Тихая глава API",
    "version": "1.0.0",
    "description": "Same-origin, cookie-authenticated author workspace. Passwords are never returned. All API responses use Cache-Control: no-store. Library mutations use optimistic concurrency; on conflict, preserve local data and fetch the server version."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    },
    {
      "url": "https://book.ayudenko.by"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Create account and session",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match APP_ORIGIN, including scheme and port."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Authenticated user; Set-Cookie issues quiet_session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 8 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After: 900",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate and issue session",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match APP_ORIGIN, including scheme and port."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated user; Set-Cookie issues quiet_session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 8 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After: 900",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "currentUser",
        "summary": "Read current session user",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke current session and expire cookie (idempotent)",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match APP_ORIGIN, including scheme and port."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Session revoked; cookie cleared"
          },
          "403": {
            "description": "Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "get": {
        "operationId": "getLibrary",
        "summary": "Read only the authenticated user’s library",
        "parameters": [
          {
            "name": "X-Account-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Current user ID from /api/auth/me. Prevents stale tabs writing after account switching. Ownership still comes exclusively from the session."
          }
        ],
        "responses": {
          "200": {
            "description": "Library and revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Account changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveLibrary",
        "summary": "Atomically replace own library if revision matches",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match APP_ORIGIN, including scheme and port."
          },
          {
            "name": "X-Account-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Current user ID from /api/auth/me. Prevents stale tabs writing after account switching. Ownership still comes exclusively from the session."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; revision incremented by one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saved"
                }
              }
            }
          },
          "400": {
            "description": "Invalid library",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict or account changed; no write performed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 20 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Unauthenticated health check including database read",
        "security": [],
        "responses": {
          "200": {
            "description": "Process and database are available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "quiet_session",
        "description": "Opaque session; HttpOnly, SameSite=Lax, Path=/, 14 days, Secure under HTTPS."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Registration": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            },
            "required": [
              "id",
              "email"
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "History": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "at": {
            "type": "string",
            "description": "Timestamp parseable as a date; client uses ISO 8601."
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "html": {
            "type": "string",
            "maxLength": 2000000
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "at",
          "title",
          "html",
          "label"
        ]
      },
      "Chapter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "html": {
            "type": "string",
            "maxLength": 2000000
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/History"
            },
            "maxItems": 60
          }
        },
        "required": [
          "id",
          "title",
          "html",
          "history"
        ]
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "character",
              "annotation",
              "location"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "body": {
            "type": "string",
            "maxLength": 100000
          },
          "quote": {
            "type": "string",
            "maxLength": 100000
          },
          "chapterId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null or an existing chapter ID in this book."
          },
          "locationType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "body",
          "quote",
          "chapterId"
        ],
        "description": "locationType is required and nonblank for kind=location. IDs must be unique within each book."
      },
      "Book": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1,
            "type": "integer"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "archived": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "subtitle": {
            "type": "string"
          },
          "goal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "activeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chapter"
            },
            "maxItems": 500,
            "minItems": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Note"
            },
            "maxItems": 2000
          },
          "outline": {
            "$ref": "#/components/schemas/Outline"
          }
        },
        "required": [
          "version",
          "id",
          "archived",
          "title",
          "goal",
          "activeId",
          "chapters",
          "notes"
        ]
      },
      "Library": {
        "type": "object",
        "properties": {
          "version": {
            "const": 2,
            "type": "integer"
          },
          "activeBookId": {
            "type": [
              "string",
              "null"
            ]
          },
          "books": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Book"
            },
            "maxItems": 100
          }
        },
        "required": [
          "version",
          "activeBookId",
          "books"
        ],
        "description": "Book IDs are unique. activeBookId is null or an existing non-archived book. activeId in each book references an existing chapter. All chapter/history/note IDs are unique within their containing list. Blank book titles are rejected. Unknown fields are removed; subtitle is normalized to Роман. The entire request is limited to 20 MiB."
      },
      "Revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "LibraryEnvelope": {
        "type": "object",
        "properties": {
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "library": {
            "$ref": "#/components/schemas/Library"
          }
        },
        "required": [
          "revision",
          "library"
        ]
      },
      "Saved": {
        "type": "object",
        "properties": {
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        },
        "required": [
          "revision"
        ]
      },
      "Outline": {
        "type": "object",
        "required": [
          "mode",
          "summary",
          "items"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "free",
              "chapters"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 100000
          },
          "items": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "body",
                "chapterId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "body": {
                  "type": "string",
                  "maxLength": 100000
                },
                "chapterId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "description": "Optional book outline. Missing means an empty free outline. Item IDs are unique; non-null chapterId references an existing chapter and is unique. Null chapterId means a freely ordered plan item. Both modes retain their content."
      }
    }
  }
}
